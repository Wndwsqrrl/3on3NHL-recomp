+/**
+ * @file        rex/core/filesystem_android.cpp
+ * @brief       Android filesystem helpers (content:// URI support)
+ *
+ * @copyright   Copyright (c) 2026 Tom Clay <tomc@tctechstuff.com>
+ *              All rights reserved.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * @remarks
+ * The declarations in rex/filesystem.h for these Android helpers were present
+ * but unimplemented. Full content:// (Storage Access Framework) support needs
+ * JNI into the Android ContentResolver. This port stages game data as plain
+ * files under the app's external storage (see windowed_app_main_sdl.cpp), so
+ * content URIs are not used; these definitions provide the required symbols and
+ * fail closed if a content:// path is ever passed. Replace with a JNI-backed
+ * implementation to support SAF-provided game data.
+ */
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_ANDROID
+
+#include <rex/filesystem.h>
+#include <rex/logging.h>
+
+namespace rex {
+namespace filesystem {
+
+void AndroidInitialize() {}
+
+void AndroidShutdown() {}
+
+bool IsAndroidContentUri(const std::string_view source) {
+  return source.starts_with("content://");
+}
+
+int OpenAndroidContentFileDescriptor(const std::string_view uri, const char* mode) {
+  (void)mode;
+  REXLOG_WARN(
+      "OpenAndroidContentFileDescriptor: content:// URIs are not supported in "
+      "this build; stage game files under the app's external storage instead "
+      "(uri: {})",
+      uri);
+  return -1;
+}
+
+}  // namespace filesystem
+}  // namespace rex
+
+#endif  // REX_PLATFORM_ANDROID
