+// SDL_main.h (included above) remaps this to SDL_main; SDL's Java activity
+// (nativeRunMain) invokes it after loading the app's shared library. Android
+// has no command line, so synthesize the data-root options, pointing them at
+// the app's external storage where the player stages their extracted game
+// files (e.g. <external>/game/extracted/default.xex). These are the same
+// --game_data_root / --user_data_root / --cache_root options the desktop
+// build accepts, so no app-specific wiring is needed.
+int main(int argc, char* argv[]) {
+  // Load API-26+ dynamic symbols (ASharedMemory_create, etc.) before the runtime
+  // constructs the guest memory arena; CreateFileMappingHandle needs them.
+  rex::InitializeAndroidApp();
+
+  std::vector<std::string> synthetic;
+  synthetic.emplace_back(argc > 0 && argv && argv[0] ? argv[0] : "nhl3on3");
+  if (const char* ext = SDL_GetAndroidExternalStoragePath()) {
+    const std::string base(ext);
+    synthetic.push_back("--game_data_root=" + base + "/game/extracted");
+    synthetic.push_back("--user_data_root=" + base + "/user");
+    synthetic.push_back("--cache_root=" + base + "/cache");
+  }
+  // Preserve any extra args SDL forwarded from the launching intent.
+  for (int i = 1; i < argc; ++i) {
+    if (argv && argv[i]) {
+      synthetic.emplace_back(argv[i]);
+    }
+  }
+  std::vector<char*> ptrs;
+  ptrs.reserve(synthetic.size());
+  for (auto& s : synthetic) {
+    ptrs.push_back(s.data());
+  }
+  return RunWindowedApp(static_cast<int>(ptrs.size()), ptrs.data());
