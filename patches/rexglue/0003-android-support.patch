+
+namespace rex {
+namespace ui {
+
+bool AndroidNativeWindowSurface::GetSizeImpl(uint32_t& width_out, uint32_t& height_out) const {
+  // Report the swapchain extent in physical pixels. SDL's pixel size tracks the
+  // ANativeWindow buffer geometry and is kept in sync across rotation/resize,
+  // so it is preferred over ANativeWindow_getWidth/Height, which can briefly
+  // report stale values around surfaceChanged. Mirrors WaylandSurface.
+  int w = 0, h = 0;
+  if (!SDL_GetWindowSizeInPixels(sdl_window_, &w, &h) || w <= 0 || h <= 0) {
+    return false;
+  }
+  width_out = uint32_t(w);
+  height_out = uint32_t(h);
+  return true;
+}
+
+}  // namespace ui
+}  // namespace rex
