@@ -0,0 +1,52 @@
+#pragma once
+/**
+ * @file        rex/main_android.h
+ * @brief       Android platform helpers (API level query, app init hooks)
+ *
+ * @copyright   Copyright (c) 2026 Tom Clay <tomc@tctechstuff.com>
+ *              All rights reserved.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_ANDROID
+#include <cstdint>
+
+namespace rex {
+
+// Returns the running device's Android API level (e.g. 26, 33). Thin wrapper
+// over the NDK's android_get_device_api_level(); used to gate loading of
+// API-26+ dynamic symbols in the POSIX backends (see memory_posix.cpp,
+// threading_posix.cpp).
+int32_t GetAndroidApiLevel();
+
+namespace memory {
+// Loads libandroid's ASharedMemory_create (API 26+), required by
+// CreateFileMappingHandle for the guest memory arena (/dev/ashmem is gone on
+// modern Android). Must be called before Memory::Initialize().
+void AndroidInitialize();
+void AndroidShutdown();
+}  // namespace memory
+
+namespace thread {
+// Loads libc's pthread_getname_np (API 26+) used for thread-name queries.
+void AndroidInitialize();
+void AndroidShutdown();
+}  // namespace thread
+
+// Convenience: run all per-module Android init (call once at startup, before the
+// runtime/memory is constructed) and shutdown.
+inline void InitializeAndroidApp() {
+  memory::AndroidInitialize();
+  thread::AndroidInitialize();
+}
+inline void ShutdownAndroidApp() {
+  thread::AndroidShutdown();
+  memory::AndroidShutdown();
+}
+
+}  // namespace rex
+#endif  // REX_PLATFORM_ANDROID
