+
+#include <android/api-level.h>
+
+namespace rex {
+
+int32_t GetAndroidApiLevel() {
+  // Runtime device API level. android_get_device_api_level() has an inline
+  // fallback (via __system_property_get) for devices below API 29, so it is
+  // safe to call on our min-SDK (26). Fall back to the compile-time target if
+  // the query ever fails.
+  int level = android_get_device_api_level();
+  return level > 0 ? level : __ANDROID_API__;
+}
+
+}  // namespace rex
+
+#endif  // REX_PLATFORM_ANDROID
