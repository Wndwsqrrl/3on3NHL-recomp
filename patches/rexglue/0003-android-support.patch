diff --git a/src/core/fiber_android.cpp b/src/core/fiber_android.cpp
new file mode 100644
index 0000000..2d61b31
--- /dev/null
+++ b/src/core/fiber_android.cpp
@@ -0,0 +1,148 @@
+/**
+ * @file        rex/core/fiber_android.cpp
+ * @brief       Android backend for rex::thread::Fiber (pthread-backed)
+ *
+ * @copyright   Copyright (c) 2026 Tom Clay <tomc@tctechstuff.com>
+ *              All rights reserved.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * @remarks
+ * Android's Bionic libc does not implement the ucontext API
+ * (getcontext/makecontext/swapcontext) used by fiber_posix.cpp. This backend
+ * gives every fiber its own pthread and enforces that exactly one fiber runs at
+ * a time: a suspended fiber's thread blocks on its condition variable until it
+ * is scheduled again. Cooperative, single-at-a-time semantics are preserved,
+ * which is what the guest-thread scheduler relies on.
+ *
+ * This is a correctness-first bringup backend. A faster drop-in replacement
+ * would be an AArch64 register-save/restore context switch (boost.context-style
+ * fcontext) that keeps all fibers on one OS thread; swap this file for that
+ * without touching callers if fiber-switch cost shows up in profiling.
+ */
+
+#include <rex/platform.h>
+#if REX_PLATFORM_ANDROID
+
+#include <rex/thread/fiber.h>
+
+#include <pthread.h>
+
+#include <cassert>
+#include <condition_variable>
+#include <mutex>
+
+namespace rex::thread {
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* f = new Fiber();
+  f->is_thread_fiber_ = true;
+  f->thread_ = pthread_self();
+  f->scheduled_ = true;  // this fiber is the one currently executing
+  tls_current_ = f;
+  return f;
+}
+
+/*static*/ void* Fiber::ThreadMain(void* arg) {
+  auto* self = static_cast<Fiber*>(arg);
+  // Each fiber runs on its own OS thread, so Fiber::Current() is just this
+  // thread's own tls_current_; SwitchTo never has to reassign it.
+  tls_current_ = self;
+
+  {
+    std::unique_lock<std::mutex> lk(self->mutex_);
+    self->cv_.wait(lk, [self] { return self->scheduled_; });
+  }
+  if (self->exit_requested_) {
+    return nullptr;
+  }
+
+  self->entry_(self->arg_);
+
+  // A guest fiber's entry is not expected to return (it switches away and is
+  // torn down from another fiber). If it ever does, park so Destroy can still
+  // join this thread cleanly.
+  for (;;) {
+    std::unique_lock<std::mutex> lk(self->mutex_);
+    self->cv_.wait(lk, [self] { return self->exit_requested_; });
+    return nullptr;
+  }
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_size_ = stack_size;
+
+  pthread_attr_t attr;
+  pthread_attr_init(&attr);
+  if (stack_size > 0) {
+    size_t want = stack_size;
+    if (want < static_cast<size_t>(PTHREAD_STACK_MIN)) {
+      want = static_cast<size_t>(PTHREAD_STACK_MIN);
+    }
+    pthread_attr_setstacksize(&attr, want);
+  }
+  int rc = pthread_create(&f->thread_, &attr, &Fiber::ThreadMain, f);
+  pthread_attr_destroy(&attr);
+  if (rc != 0) {
+    delete f;
+    return nullptr;
+  }
+  return f;
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* self = tls_current_;
+  assert(self && "SwitchTo called on a thread that is not a fiber");
+  if (target == self) {
+    return;
+  }
+
+  // Mark self as not runnable BEFORE waking the target. If the target
+  // immediately switches back to us, it sets self->scheduled_ = true after this
+  // point, so the wait below observes it (and never clobbers it).
+  {
+    std::lock_guard<std::mutex> lk(self->mutex_);
+    self->scheduled_ = false;
+  }
+  {
+    std::lock_guard<std::mutex> lk(target->mutex_);
+    target->scheduled_ = true;
+  }
+  target->cv_.notify_one();
+
+  {
+    std::unique_lock<std::mutex> lk(self->mutex_);
+    self->cv_.wait(lk, [self] { return self->scheduled_; });
+  }
+}
+
+void Fiber::Destroy() {
+  if (is_thread_fiber_) {
+    // Wraps the owning OS thread; nothing to join.
+    if (this == tls_current_) {
+      tls_current_ = nullptr;
+    }
+    delete this;
+    return;
+  }
+
+  assert(this != tls_current_ && "Destroy called on the currently running fiber");
+  {
+    std::lock_guard<std::mutex> lk(mutex_);
+    exit_requested_ = true;
+    scheduled_ = true;  // unblock the thread whether it is pre-start or parked
+  }
+  cv_.notify_one();
+  pthread_join(thread_, nullptr);
+  delete this;
+}
+
+}  // namespace rex::thread
+
+#endif  // REX_PLATFORM_ANDROID
diff --git a/src/core/filesystem_android.cpp b/src/core/filesystem_android.cpp
